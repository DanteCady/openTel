# Database (Postgres is default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/opentel

# MySQL (alternative - use when running with docker-compose mysql service)
# DATABASE_URL=mysql://root:root@localhost:3306/opentel

# Redis
REDIS_URL=redis://localhost:6379

# NATS (use 127.0.0.1 if Docker is up and localhost resolves to IPv6)
NATS_URL=nats://127.0.0.1:4222

# JWT
JWT_SECRET=change-me-in-production

# Secrets (for channel config - email/SMS API keys, etc.; see docs/CHANNELS_DESIGN.md)
# SECRETS_PROVIDER=encrypted_db
# SECRETS_ENCRYPTION_KEY=32-byte-hex-key-change-me-in-production

# API
API_PORT=3000
# Optional rate limiting (per tenant or per IP when no token)
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_MAX=200
# RATE_LIMIT_TIME_WINDOW_MS=60000
# Base URL for OAuth callbacks (defaults to http://localhost:API_PORT if unset)
# API_BASE_URL=https://api.example.com

# Gmail OAuth (optional; for "Connect your inbox" email channel)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# Microsoft OAuth (optional; for Microsoft 365 email channel)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common

# Signaling
SIGNALING_PORT=3001

# WebRTC (optional - defaults to coturn when using docker-compose)
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478

# OpenTelemetry (optional; see docs/TELEMETRY.md)
# OTEL_ENABLED=1
# OTEL_SERVICE_NAME=opentel
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Phase 2 - PSTN (optional; see docs/PHASE2_PSTN.md)
# OPENTEL_GATEWAY_URL=http://gateway:8021
# OPENTEL_SIP_TRUNK_HOST=
# OPENTEL_SIP_TRUNK_PORT=5060
# OPENTEL_SIP_TRUNK_USER=
# OPENTEL_SIP_TRUNK_PASSWORD=
# Inbound PSTN: gateway POSTs to signaling /inbound-call; these pick which endpoint rings
# OPENTEL_INBOUND_TENANT_ID=
# OPENTEL_INBOUND_DEFAULT_ENDPOINT_ID=
# Optional: secure /inbound-call (see docs/PHASE2_PSTN.md and docs/SECURITY.md)
# OPENTEL_INBOUND_SECRET=shared-secret-for-gateway
# OPENTEL_INBOUND_ALLOWED_IPS=10.0.0.1,192.168.1.2
